from types import CapsuleType

class Buffer:
    handle: int
    def copy_from(self, source: Buffer, *, stream: Stream) -> None: ...
    def __dlpack__(self, *, stream: int | None = ...) -> CapsuleType: ...
    def __dlpack_device__(self) -> tuple[int, int]: ...

class PinnedMemoryResource:
    def allocate(self, size: int, *, stream: Stream) -> Buffer: ...

class GraphBuilder:
    stream: Stream
    def begin_building(self) -> None: ...
    def end_building(self) -> None: ...
    def complete(self) -> Graph: ...

class Graph:
    def upload(self, stream: Stream) -> None: ...
    def launch(self, stream: Stream) -> None: ...

class Stream:
    handle: int
    def sync(self) -> None: ...
    def create_graph_builder(self) -> GraphBuilder: ...

class Device:
    arch: str
    name: str
    def __init__(self, device_id: int = ...) -> None: ...
    def set_current(self) -> None: ...
    def create_stream(self) -> Stream: ...
    def allocate(self, size: int, *, stream: Stream) -> Buffer: ...
