import enum
from collections.abc import Sequence

__version__: str

class Logger:
    WARNING: Logger.Severity
    class Severity(enum.IntEnum): ...

    def __init__(self, min_severity: Logger.Severity = ...) -> None: ...

class DataType(enum.Enum):
    FLOAT = ...
    HALF = ...
    INT32 = ...
    INT64 = ...
    BOOL = ...

class TensorIOMode(enum.Enum):
    INPUT = ...
    OUTPUT = ...

class BuilderFlag(enum.IntEnum):
    TF32 = ...

class NetworkDefinitionCreationFlag(enum.IntEnum):
    STRONGLY_TYPED = ...

class IHostMemory:
    nbytes: int
    def __buffer__(self, flags: int, /) -> memoryview: ...

class ITimingCache:
    def serialize(self) -> IHostMemory: ...

class IBuilderConfig:
    builder_optimization_level: int
    def clear_flag(self, flag: BuilderFlag) -> None: ...
    def create_timing_cache(self, blob: bytes) -> ITimingCache: ...
    def set_timing_cache(self, cache: ITimingCache, ignore_mismatch: bool) -> bool: ...

class INetworkDefinition: ...
class IParserError: ...

class OnnxParser:
    num_errors: int
    def __init__(self, network: INetworkDefinition, logger: Logger) -> None: ...
    def parse_from_file(self, path: str) -> bool: ...
    def get_error(self, index: int) -> IParserError: ...

class Builder:
    def __init__(self, logger: Logger) -> None: ...
    def create_network(self, flags: int = ...) -> INetworkDefinition: ...
    def create_builder_config(self) -> IBuilderConfig: ...
    def build_serialized_network(
        self, network: INetworkDefinition, config: IBuilderConfig
    ) -> IHostMemory | None: ...

class IExecutionContext:
    def set_tensor_address(self, name: str, address: int) -> bool: ...
    def execute_async_v3(self, stream_handle: int) -> bool: ...

class ICudaEngine:
    num_io_tensors: int
    def get_tensor_name(self, index: int) -> str: ...
    def get_tensor_shape(self, name: str) -> Sequence[int]: ...
    def get_tensor_dtype(self, name: str) -> DataType: ...
    def get_tensor_mode(self, name: str) -> TensorIOMode: ...
    def create_execution_context(self) -> IExecutionContext: ...

class Runtime:
    def __init__(self, logger: Logger) -> None: ...
    def deserialize_cuda_engine(self, blob: bytes) -> ICudaEngine | None: ...
